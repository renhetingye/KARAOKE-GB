{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KARAOKE-GB",
  "version": "0.1.0",
  "identifier": "net.godbaby.karaokegb",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "KARAOKE-GB - WASAPI Low-Latency Engine",
        "url": "index.html",
        "width": 1280,
        "height": 850,
        "center": true,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
