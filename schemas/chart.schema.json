{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Karaoke Chart 2.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requiredFeatures",
    "songId",
    "chartId",
    "chartRevision",
    "title",
    "artist",
    "durationUs",
    "credits",
    "media",
    "tracks",
    "tempoMap",
    "notes",
    "lyricTokens",
    "phrases",
    "extensions"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0.0"
    },
    "requiredFeatures": {
      "type": "array",
      "minItems": 0,
      "maxItems": 2,
      "items": {
        "enum": [
          "single-melody",
          "step-tempo"
        ]
      }
    },
    "songId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,96}$"
    },
    "chartId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,96}$"
    },
    "chartRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "artist": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "durationUs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 600000000
    },
    "credits": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "sourceUrl",
          "licenseName"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "sourceUrl": {
            "type": "string",
            "maxLength": 2048
          },
          "licenseName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    },
    "media": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/media"
      }
    },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "role"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,96}$"
          },
          "role": {
            "const": "lead"
          }
        }
      }
    },
    "tempoMap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anchorTimeUs",
        "anchorQuarterBeat",
        "events",
        "meters"
      ],
      "properties": {
        "anchorTimeUs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 600000000
        },
        "anchorQuarterBeat": {
          "type": "number",
          "minimum": -1000,
          "maximum": 100000
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "timeUs",
              "bpm"
            ],
            "properties": {
              "timeUs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 600000000
              },
              "bpm": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1000
              }
            }
          }
        },
        "meters": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "quarterBeat",
              "numerator",
              "denominator"
            ],
            "properties": {
              "quarterBeat": {
                "type": "number",
                "minimum": -1000,
                "maximum": 100000
              },
              "numerator": {
                "type": "integer",
                "minimum": 1,
                "maximum": 32
              },
              "denominator": {
                "enum": [
                  1,
                  2,
                  4,
                  8,
                  16
                ]
              }
            }
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "minItems": 0,
      "maxItems": 100000,
      "items": {
        "$ref": "#/$defs/note"
      }
    },
    "lyricTokens": {
      "type": "array",
      "minItems": 0,
      "maxItems": 50000,
      "items": {
        "$ref": "#/$defs/token"
      }
    },
    "phrases": {
      "type": "array",
      "minItems": 0,
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/phrase"
      }
    },
    "extensions": {
      "type": "object",
      "maxProperties": 64
    }
  },
  "$defs": {
    "note": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "trackId",
        "startUs",
        "endUs",
        "pitchMidi",
        "tuningCents",
        "scorable"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,96}$"
        },
        "trackId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,96}$"
        },
        "startUs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 600000000
        },
        "endUs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 600000000
        },
        "pitchMidi": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "tuningCents": {
          "type": "number",
          "minimum": -50,
          "maximum": 50
        },
        "scorable": {
          "type": "boolean"
        }
      }
    },
    "token": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "ruby",
        "noteIds",
        "startUs",
        "endUs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,96}$"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "ruby": {
          "type": "string",
          "maxLength": 256
        },
        "noteIds": {
          "type": "array",
          "minItems": 0,
          "maxItems": 10000,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,96}$"
          }
        },
        "startUs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 600000000
        },
        "endUs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 600000000
        }
      }
    },
    "phrase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "startUs",
        "endUs",
        "tokenIds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,96}$"
        },
        "startUs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 600000000
        },
        "endUs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 600000000
        },
        "tokenIds": {
          "type": "array",
          "minItems": 0,
          "maxItems": 50000,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,96}$"
          }
        }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "role",
        "sha256",
        "sampleRate",
        "channels",
        "frames",
        "mediaOffsetUs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,96}$"
        },
        "path": {
          "type": "string",
          "pattern": "^media/[A-Za-z0-9_-]+\\.(flac|wav)$"
        },
        "role": {
          "enum": [
            "backing",
            "guide"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sampleRate": {
          "const": 48000
        },
        "channels": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "frames": {
          "type": "integer",
          "minimum": 1,
          "maximum": 28800000
        },
        "mediaOffsetUs": {
          "type": "integer",
          "minimum": -600000000,
          "maximum": 600000000
        }
      }
    }
  }
}
